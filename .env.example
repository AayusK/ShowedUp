# Copy to .env.local and fill in. All of these are server-only: never prefix with NEXT_PUBLIC_.

# Organizer wallet secret key (base58 or JSON byte array). Create one with `npm run organizer`.
ORGANIZER_SECRET_KEY=

# Any long random string. Signs the rotating QR codes.
EVENT_SECRET=

# Password of the registry admin (creates and verifies clubs). Also the default club's passcode.
ORGANIZER_PASSWORD=

# Any long random string (32+ characters). Every club's Solana wallet is worked out from it, so
# no club key is ever stored. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it once clubs exist: every club would get a new wallet, and the badges they
# already issued would stop counting. Without it, only the default club can issue badges.
CLUB_KEY_SECRET=

# Devnet RPC URL (e.g. a Helius devnet URL). Leave empty to use the public devnet endpoint.
RPC_URL=

# Supabase project URL and secret key (sb_secret_...).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: security token of the QuickNode Stream that feeds /api/streams/claims (a secret).
# Leave empty to keep the live claim feed off. See README, "Live claim feed".
QUICKNODE_STREAM_TOKEN=

# Optional: Privy app ID (dashboard.privy.io) to let attendees sign in with email or Google
# instead of Phantom. This one is not a secret. Leave empty to keep Phantom-only.
PRIVY_APP_ID=
